EXEC_ENV=development
DATABASE_URL=mysql+aiomysql://root:password@${BACKEND_NAME}-database/${DB_NAME}?ssl_disabled=true
ECHO_SQL=false
LOG_LEVEL=DEBUG
PROJECT_NAME=${PROJECT_NAME}
VERSION=1.0.0

# Must match CRON_SECRET in the main repo .env (compose passes this as environment for the app).
INTERNAL_CRON_SECRET=

REDIS_URL=redis://redis:6379
REDIS_KEY_PREFIX=${PROJECT_NAME}:

JWT_SECRET_KEY=dev-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Transactional email (identity verification links). Tied to the log transport in dev — check app logs.
EMAIL_FROM_ADDRESS=noreply@example.com
EMAIL_FROM_NAME=${PROJECT_NAME}
# Frontend base URL for links in emails (e.g. gateway http://localhost or http://localhost:5173 for direct Vite)
EMAIL_VERIFY_BASE_URL=http://localhost
